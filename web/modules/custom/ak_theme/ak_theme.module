<?php

/**
 * @file
 * Primary module hooks for AK Theme module.
 */

use Drupal\Component\Serialization\Json;

function ak_theme_theme($existing, $type, $theme, $path) {
  return [
    'exhibition_years' => [
      'variables' => [
        'years' => [],
        'title' => NULL,
        'current' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK().
 *
 * Adds a schema.org ItemList for the exhibitions featured on the frontpage.
 */
function ak_theme_preprocess_field__node__field_featured_exhibitions(&$vars) {
  $entities = [];
  foreach ($vars['element']['#items'] as $item) {
    if ($item->entity && $item->entity->access('view')) {
      $entities[$item->entity->id()] = $item->entity;
    }
  }
  if (!$entities || !\Drupal::hasService('ibase_seo.schema_builder')) {
    return;
  }
  $vars['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value' => Json::encode(\Drupal::service('ibase_seo.schema_builder')->itemList($entities, 'Aktuell', 0)),
    ],
    'ak_theme_itemlist_featured_exhibitions',
  ];
}

/**
 * Implements hook_preprocess_HOOK().
 */
function ak_theme_preprocess_block(&$vars) {
  // Add year to copyright block.
  if (isset($vars['plugin_id']) && $vars['plugin_id'] === 'block_content:4b60f217-8746-4af7-a68c-ffcd1c41e75e') {
    $raw = strip_tags($vars["content"]["body"][0]["#text"]);
    $year = date('Y');
    $vars["content"]["body"][0]["#text"] = "<small>$raw$year</small>";
  }

}
