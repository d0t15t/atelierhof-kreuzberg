<?php

/**
 * @file
 * Primary module hooks for AK Theme module.
 */

use Drupal\Component\Serialization\Json;
use Drupal\Core\Language\LanguageInterface;
use Drupal\Core\TypedData\TranslatableInterface;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;

function ak_theme_theme($existing, $type, $theme, $path) {
  return [
    'exhibition_years' => [
      'variables' => [
        'years' => [],
        'title' => NULL,
        'current' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_node_links_alter().
 *
 * Core only adds "Read more" in the teaser view mode; the frontpage's
 * featured cards need it too.
 */
function ak_theme_node_links_alter(array &$links, NodeInterface $entity, array &$context) {
  if ($context['view_mode'] !== 'featured' || !isset($links['node']['#links'])) {
    return;
  }
  $title = strip_tags($entity->label());
  $links['node']['#links']['node-readmore'] = [
    'title' => t('Read more<span class="visually-hidden"> about @title</span>', ['@title' => $title]),
    'url' => $entity->toUrl(),
    'language' => $entity->language(),
    'attributes' => [
      'rel' => 'tag',
      'title' => $title,
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK().
 *
 * Adds a schema.org ItemList for the exhibitions featured on the frontpage.
 */
function ak_theme_preprocess_field__node__field_featured_exhibitions(&$vars) {
  $entities = [];
  foreach ($vars['element']['#items'] as $item) {
    if ($item->entity && $item->entity->access('view')) {
      $entities[$item->entity->id()] = $item->entity;
    }
  }
  if (!$entities || !\Drupal::hasService('ibase_seo.schema_builder')) {
    return;
  }
  $vars['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value' => Json::encode(\Drupal::service('ibase_seo.schema_builder')->itemList($entities, 'Aktuell', 0)),
    ],
    'ak_theme_itemlist_featured_exhibitions',
  ];
}

/**
 * Implements hook_preprocess_HOOK().
 */
function ak_theme_preprocess_block(&$vars) {
  // Add year to copyright block.
  if (isset($vars['plugin_id']) && $vars['plugin_id'] === 'block_content:4b60f217-8746-4af7-a68c-ffcd1c41e75e') {
    $raw = strip_tags($vars["content"]["body"][0]["#text"]);
    $year = date('Y');
    $vars["content"]["body"][0]["#text"] = "<small>$raw$year</small>";
  }

}

/**
 * Implements hook_language_switch_links_alter().
 *
 * Marks the languages the current content has no translation in, so the
 * switcher can show them without linking to the untranslated page.
 */
function ak_theme_language_switch_links_alter(array &$links, $type, Url $url) {
  if (!$url->isRouted()) {
    return;
  }
  $parameters = $url->getRouteParameters();
  foreach (['node', 'taxonomy_term'] as $entity_type_id) {
    if ($url->getRouteName() === "entity.$entity_type_id.canonical" && isset($parameters[$entity_type_id])) {
      $entity = \Drupal::entityTypeManager()->getStorage($entity_type_id)->load($parameters[$entity_type_id]);
      if ($entity instanceof TranslatableInterface) {
        foreach ($links as $langcode => &$link) {
          if (!$entity->hasTranslation($langcode)) {
            // The theme renders these as plain text.
            $link['attributes']['class'][] = 'is-untranslated';
            $link['attributes']['title'] = t('Not available in this language');
          }
        }
      }
    }
  }
}

/**
 * Implements hook_preprocess_HOOK().
 *
 * The status label is a term, rendered in the exhibition's language. Show it
 * in the page's language instead, so an English page reads "Ongoing" even
 * when the exhibition itself is only in German.
 */
function ak_theme_preprocess_field__node__field_status(&$vars) {
  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
  foreach ($vars['element']['#items'] as $delta => $item) {
    $term = $item->entity;
    if ($term instanceof TranslatableInterface && $term->hasTranslation($langcode) && isset($vars['items'][$delta]['content']['#plain_text'])) {
      $vars['items'][$delta]['content']['#plain_text'] = $term->getTranslation($langcode)->label();
    }
  }
}
