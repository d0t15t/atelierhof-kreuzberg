{
    "name": "d0t15t/atelierhof-kreuzberg",
    "description": "Atelierhof Kreuzberg (atelierhof-kreuzberg.com) Drupal site",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "commerceguys/addressing": "^2.1.1",
        "commerceguys/intl": "^2.0",
        "composer/installers": "^2.2",
        "cweagans/composer-patches": "^1.7",
        "drupal/address": "^2.0.4",
        "drupal/admin_toolbar": "^3.4",
        "drupal/backup_migrate": "^5.0",
        "drupal/better_exposed_filters": "^7.0",
        "drupal/bootstrap5": "^4.0",
        "drupal/core-composer-scaffold": "~11.4.11",
        "drupal/core-project-message": "~11.4.11",
        "drupal/core-recommended": "~11.4.11",
        "drupal/current_year": "^1.0",
        "drupal/date_filter": "^1.0",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/field_formatter_range": "^1.4",
        "drupal/field_group": "^4.0",
        "drupal/file_delete": "^3.0.3",
        "drupal/file_entity": "^2.0@RC",
        "drupal/file_management": "^2.1",
        "drupal/gin": "^5.0.16",
        "drupal/heading": "^2.0",
        "drupal/hide_revision_field": "^2.5",
        "drupal/jquery_ui": "^1.8",
        "drupal/layout_builder_component_attributes": "^2.2",
        "drupal/linked_field": "^1.5",
        "drupal/media_entity_download": "^2.2",
        "drupal/metatag": "^2.2",
        "drupal/migrate_devel": "^3.1",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_tools": "^6.1",
        "drupal/migrate_upgrade": "^4.0",
        "drupal/name": "^1.0@RC",
        "drupal/pathauto": "^1.12",
        "drupal/pub_options": "^3.0",
        "drupal/quick_node_clone": "*",
        "drupal/rabbit_hole": "^1.0@beta",
        "drupal/simple_sitemap": "^4.2",
        "drupal/taxonomy_menu_ui": "^3.0",
        "drupal/telephone": "^1.0",
        "drupal/token": "^1.17",
        "drupal/views_bulk_operations": "4.3.x-dev@dev",
        "drupal/views_year_filter": "^2.1",
        "drupal/webp": "^1.0@RC",
        "drush/drush": "^13",
        "mglaman/composer-drupal-lenient": "^1.0",
        "oomphinc/composer-installers-extender": "^2.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "cweagans/composer-patches": true,
            "php-http/discovery": true,
            "mglaman/composer-drupal-lenient": true,
            "oomphinc/composer-installers-extender": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/robots.txt": false,
                "[web-root]/sites/development.services.yml": false
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ]
        },
        "enable-patching": true,
        "patches": {
            "drupal/core": {
                "Also use text editor (CKEditor) for \"summary\" of a text field: https://www.drupal.org/project/drupal/issues/2671162": "patches/ckeditor-summary-drupal11.patch"
            },
            "drupal/linked_field": {
                "Illegal offset type in isset or empty at ContentEntityBase.php - https://www.drupal.org/project/linked_field/issues/3480280#comment-15811952": "patches/linked-field-array-destination.patch"
            },
            "drupal/file_management": {
                "Drupal 11 and PHP 8.4+ compatibility: https://www.drupal.org/project/file_management/issues/3430563": "patches/file-management-drupal11.patch"
            }
        },
        "drupal-lenient": {
            "allowed-list": [
                "drupal/file_management"
            ]
        },
        "composer-exit-on-patch-failure": true
    },
    "require-dev": {
        "drupal/stage_file_proxy": "^3.1.6"
    }
}
